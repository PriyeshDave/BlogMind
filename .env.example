# OpenAI API
OPENAI_API_KEY=sk-xxxxxxxx

# dev.to (used as the Medium-import bridge, and as a standalone channel)
DEVTO_API_KEY=xxxxxxxx

# LinkedIn (personal profile posting)
LINKEDIN_ACCESS_TOKEN=xxxxxxxx
LINKEDIN_PERSON_URN=urn:li:person:xxxxxxxx

# GitHub (used by the Action to open review PRs; not needed for local runs
# unless you're testing src/review/create_pr.py directly)
GH_TOKEN=xxxxxxxx
GH_REPO=yourusername/agentic-ai-blog-automation

# Your canonical site base URL, used for LinkedIn share links + Medium canonical
SITE_BASE_URL=https://yourblog.example.com
